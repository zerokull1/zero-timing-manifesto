#version 450
#extension GL_ARB_gpu_shader_int64 : enable
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer IatBuffer {
    uint64_t ring[256];
    uint alert_flag;
};

void main() {
    uint idx = gl_LocalInvocationID.x;
    if (idx > 0 && idx < 256) {
        uint64_t delta = ring[idx] - ring[idx - 1];
        if (delta > 5000ul || delta < 10ul) {
            atomicAdd(alert_flag, 1u);
        }
    }
}
